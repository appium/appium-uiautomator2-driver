{
  "name": "appium-uiautomator2-driver",
  "version": "8.4.0",
  "description": "UiAutomator2 integration for Appium",
  "keywords": [
    "android",
    "appium",
    "automated testing",
    "uiautomator2"
  ],
  "bugs": {
    "url": "https://github.com/appium/appium-uiautomator2-driver/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-uiautomator2-driver.git"
  },
  "bin": {},
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib",
    "build/lib",
    "scripts",
    "CHANGELOG.md",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "npm run build -- --clean",
    "dev": "npm run build -- --watch",
    "e2e-test:commands": "node --test --test-concurrency=1 --test-timeout=600000 \"build/test/functional/commands/*-e2e-specs.js\"",
    "e2e-test:commands:find": "node --test --test-concurrency=1 --test-timeout=600000 \"build/test/functional/commands/find/*-e2e-specs.js\"",
    "e2e-test:commands:general": "node --test --test-concurrency=1 --test-timeout=600000 \"build/test/functional/commands/general/*-e2e-specs.js\"",
    "e2e-test:commands:keyboard": "node --test --test-concurrency=1 --test-timeout=600000 \"build/test/functional/commands/keyboard/*-e2e-specs.js\"",
    "e2e-test:driver": "node --test --test-concurrency=1 --test-timeout=600000 \"build/test/functional/driver/*-e2e-specs.js\"",
    "e2e-test": "node --test --test-concurrency=1 --test-timeout=600000 \"build/test/functional/**/*-e2e-specs.js\"",
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint:commit": "commitlint",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix .",
    "prepare": "npm run rebuild",
    "rebuild": "npm run clean; npm run build",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "reset": "node ./scripts/reset.mjs",
    "test": "node --test --test-timeout=60000 \"build/test/unit/**/*-specs.js\""
  },
  "dependencies": {
    "@appium/css-locator-to-native": "^1.0.1",
    "appium-adb": "^16.0.0",
    "appium-android-driver": "^14.0.2",
    "appium-uiautomator2-server": "^10.6.0",
    "asyncbox": "^6.0.1",
    "axios": "^1.16.0",
    "io.appium.settings": "^8.0.1",
    "portscanner": "^2.2.0",
    "teen_process": "^4.0.4"
  },
  "devDependencies": {
    "@appium/docutils": "^2.0.0-rc.1",
    "@appium/oxc-config": "^1.1.0",
    "@appium/semantic-release-config": "^1.1.0",
    "@appium/support": "^7.0.0-rc.1",
    "@appium/tsconfig": "^1.2.0",
    "@appium/types": "^1.5.0",
    "@types/node": "^26.0.0",
    "@types/portscanner": "^2.1.1",
    "@types/semver": "^7.5.0",
    "@types/sinon": "^22.0.0",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.5.4",
    "@xmldom/xmldom": "^0.x",
    "sharp": "^0.x",
    "sinon": "^22.0.0",
    "unzipper": "^0.x",
    "webdriverio": "^9.0.9",
    "xpath": "^0.x"
  },
  "peerDependencies": {
    "appium": "^3.0.0-rc.2"
  },
  "optionalDependencies": {
    "sharp": "^0.x"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "appium": {
    "driverName": "uiautomator2",
    "automationName": "UiAutomator2",
    "platformNames": [
      "Android"
    ],
    "mainClass": "AndroidUiautomator2Driver",
    "scripts": {
      "reset": "scripts/reset.mjs"
    },
    "doctor": {
      "checks": [
        "./build/lib/doctor/required-checks.js",
        "./build/lib/doctor/optional-checks.js"
      ]
    }
  }
}
